# Copy this file to .env (repo root). Read by docker-compose.yml only,
# to configure the Postgres container. Backend app config lives in
# backend/.env (see backend/.env.example) -- keep the credentials in sync
# between the two.

POSTGRES_USER=msme_admin
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=msme_compliance
POSTGRES_PORT=5432
