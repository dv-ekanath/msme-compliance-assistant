{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RegulatoryDocumentSeedEntry",
  "description": "One entry = one RegulatoryDocument, chunked by app/rag/chunking.py and embedded by app/rag/ingestion.py into RegulatoryChunk rows.",
  "type": "object",
  "required": ["code", "regulation_code", "title", "authority", "jurisdiction", "source_url", "document_type", "version", "status", "sections"],
  "properties": {
    "code": { "type": "string", "description": "Unique document identifier, e.g. \"GST-DEMO-01\"" },
    "regulation_code": { "type": "string", "description": "Must match a code in backend/seed/regulations/" },
    "title": { "type": "string" },
    "authority": { "type": "string" },
    "jurisdiction": { "type": "string" },
    "source_url": { "type": "string", "format": "uri" },
    "document_type": { "enum": ["act", "notification", "circular", "faq", "demo_excerpt", "other"] },
    "effective_date": { "type": ["string", "null"], "format": "date" },
    "version": { "type": "string" },
    "status": {
      "enum": ["verified", "demo", "unverified"],
      "description": "verified = confirmed authoritative text; demo = system-authored summary, not verbatim; unverified = ingested but not yet reviewed (never surfaced by retrieval)"
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["section", "content"],
        "properties": {
          "section": { "type": ["string", "null"] },
          "subsection": { "type": ["string", "null"] },
          "source_reference": { "type": ["string", "null"], "description": "e.g. \"CGST Act 2017, Section 22\"" },
          "source_page": { "type": ["string", "null"] },
          "content": { "type": "string" }
        }
      }
    }
  }
}
