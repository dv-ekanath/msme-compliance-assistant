# Copy this file to backend/.env and adjust as needed.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Must match the postgres service in docker-compose.yml / root .env
DATABASE_URL=postgresql+psycopg://msme_admin:changeme_dev_password@localhost:5432/msme_compliance

# --- LLM provider ---
# "mock"      -> no API key needed, no external calls, safe default for dev
# "anthropic" -> requires ANTHROPIC_API_KEY below AND `pip install anthropic`
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
