# Copy this file to backend/.env and adjust as needed.

APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Must match the postgres service in docker-compose.yml / root .env
DATABASE_URL=postgresql+psycopg://msme_admin:changeme_dev_password@localhost:5432/msme_compliance

# --- LLM provider ---
# "mock"      -> no API key needed, no external calls, safe default for dev
# "anthropic" -> requires ANTHROPIC_API_KEY below AND `pip install anthropic`
# "groq"      -> requires GROQ_API_KEY below
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Embedding provider (RAG) ---
# "local" -> sentence-transformers, runs on-box, no API key/credits (default)
# "mock"  -> deterministic, dependency-free, used by the test suite
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- Compliance Copilot (RAG retrieval tuning) ---
COPILOT_TOP_K=5
COPILOT_SIMILARITY_THRESHOLD=0.3

# --- OCR provider (Phase 4 document extraction) ---
# "easyocr" -> runs on-box, no API key/credits, downloads a model on first
#              use (default)
# "mock"    -> deterministic, dependency-free, used by the test suite
OCR_PROVIDER=easyocr
OCR_LANGUAGES=en

# --- Auth (Phase 5) ---
# Dev-only default -- override for any non-local deployment.
JWT_SECRET_KEY=dev-only-insecure-secret-change-in-production
JWT_EXPIRY_HOURS=24
